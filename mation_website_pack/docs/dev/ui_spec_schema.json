{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MationUIRenderSpec",
  "type": "object",
  "required": [
    "layout",
    "title",
    "components"
  ],
  "properties": {
    "layout": {
      "type": "string",
      "enum": [
        "canvas"
      ]
    },
    "title": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "props"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "props": {
            "type": "object"
          }
        }
      }
    }
  }
}